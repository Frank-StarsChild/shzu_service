# 依赖与构建产物
node_modules/
frontend/dist/
.venv/
__pycache__/
*.pyc

# 运行数据（产物文件与本地数据库）
data/artifacts/*
!data/artifacts/.gitkeep
data/app.sqlite3

# 评测临时结果（保留报告目录说明）
