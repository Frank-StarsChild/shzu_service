{
  "name": "shzu-agent-frontend",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "check:bundle": "node scripts/check-bundle.mjs",
    "test:unit": "vitest run",
    "test:e2e": "npm run build && playwright test",
    "verify": "npm run build && npm run check:bundle && npm run test:unit && npm run test:e2e"
  },
  "dependencies": {
    "pinia": "^2.2.6",
    "three": "0.187.0",
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "^20.17.6",
    "@types/three": "0.187.0",
    "@vitejs/plugin-vue": "^5.2.1",
    "pngjs": "7.0.0",
    "typescript": "~5.6.2",
    "vite": "^5.4.11",
    "vitest": "3.2.4",
    "vue-tsc": "^2.1.10"
  }
}
